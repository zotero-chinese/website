{
  // Disable the default formatter, use oxc instead
  "prettier.enable": false,
  "oxc.fmt.configPath": "./vite.config.ts",
  "oxc.enable": true,

  /** 编辑器相关 */
  "editor.formatOnSave": true,
  "editor.formatOnType": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.prettier": "never",
    "source.fixAll.markdownlint": "always",
    "source.fixAll.oxc": "always",
    "source.fixAll": "always",
    "source.organizeImports": "never"
  },

  "[markdown]": {
    "editor.fontFamily": "Sarasa Mono SC, Noto Sans Mono CJK SC, monospace",
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  /** Markdown 相关 */
  "markdown.validate.enabled": true,
  "markdown.validate.fileLinks.enabled": "error",
  "markdown.validate.referenceLinks.enabled": "ignore",
  // "markdown.copyFiles.destination": {
  //   "**/*": "${documentWorkspaceFolder}/src/assets/"
  // },
  "markdown.updateLinksOnFileMove.enabled": "always",
  "markdown.editor.pasteUrlAsFormattedLink.enabled": "smart",
  "markdownlint.config": {
    "MD025": {
      "front_matter_title": ""
    }
  },

  /** 文件管理器相关  */
  // "explorer.sortOrder": "mixed",
  "explorer.excludeGitIgnore": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true

    /** custom begin */

    // npm
    // "node_modules": true,
    // "package.json": true
    // "package-lock.json": true,
    // "pnpm-lock.yaml": true,

    // Git and GitHub config
    // "**/.*": true,
    // ".github": true,
    // ".gitignore": true,
    // ".husky": true,

    // 3rd package config
    // ".vscode": true,
    // ".markdownlint.jsonc": true,
    // ".prettierignore": true,
    // "**/.vuepress": true,
    // "LICENSE": true
  },

  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  }
}
